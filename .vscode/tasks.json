{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uv: sync",
      "type": "process",
      "command": "uv",
      "args": [
        "sync",
        "--locked"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "detail": "Install the locked Python environment, including development tools",
      "problemMatcher": []
    },
    {
      "label": "Python: check Ruff formatting",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "ruff",
        "format",
        "--check",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Python: check types",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "ty",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Python: lint",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "ruff",
        "check",
        "--output-format",
        "concise",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "python",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+([A-Z]\\d+)\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Cursors: build complete animated themes",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "python",
        "process_cursors.py",
        "--jobs",
        "2"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "detail": "Build the release cursor packages in dist/",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Nix: check flake (Linux)",
      "type": "process",
      "command": "nix",
      "args": [
        "flake",
        "check",
        "--print-build-logs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "detail": "Run in a Linux workspace; this flake supports x86_64-linux and aarch64-linux",
      "problemMatcher": []
    }
  ]
}
